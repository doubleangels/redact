    <string name="settings_section_advanced_privacy">Limpeza de Metadados</string>
    <string name="settings_advanced_privacy_subtitle">Como o Redact remove informações ocultas — como localização e detalhes da câmera (EXIF) — na aba Limpar. Arquivos compartilhados de outros apps sempre têm essas informações removidas antes de serem encaminhados.</string>
    <string name="settings_secure_delete">Passagens de Exclusão Segura</string>
    <string name="settings_secure_delete_subtitle">Quantas vezes os arquivos temporários — incluindo cópias originais não editadas de fotos e vídeos antes da limpeza — são sobrescritos antes de excluir, para que seus dados não possam ser recuperados do disco. Mais passagens = mais lento; em armazenamento flash a recuperação ainda pode ser possível.</string>
    <string name="settings_auto_clear_temp">Limpar Cache ao Iniciar</string>
    <string name="settings_auto_clear_temp_subtitle">Remove arquivos de cache de processamento com mais de 24 horas ao abrir o app.</string>
    <string name="settings_preserve_camera">Manter Configurações da Câmera</string>
    <string name="settings_preserve_camera_subtitle">Manter abertura, velocidade do obturador, ISO e marca/modelo da câmera em Limpar. Ignorado com Limpeza Rigorosa ou ao compartilhar de outros apps.</string>
    <string name="settings_preserve_location">Manter Localização</string>
    <string name="settings_preserve_location_subtitle">Manter coordenadas GPS em Limpar. Ignorado com Limpeza Rigorosa ou ao compartilhar de outros apps.</string>
        <string name="settings_sentry_consent_allow">Ativar</string>
    <string name="settings_sentry_consent_cancel">Agora Não</string>
    <string name="settings_sentry_consent_title">Ativar Relatórios de Falha?</string>
    <string name="settings_sentry_consent_message">Enviar Relatórios de Falha envia diagnósticos anonimizados ao Sentry pela internet.\n\nFotos, vídeos, nomes de arquivo e coordenadas GPS não são enviados.</string>
    <string name="settings_strict_clean">Limpeza Rigorosa</string>
    <string name="settings_strict_clean_subtitle">Remove todo vestígio de metadados, até a tag de orientação — por isso uma foto girada pode parecer torta depois. Desativa as opções de manter acima e sempre recodifica o vídeo por completo para a limpeza mais completa.</string>
    
    <string name="settings_section_advanced_processing">Arquivos Grandes e Memória</string>
    <string name="settings_advanced_processing_subtitle">Controla o uso de RAM ao decodificar imagens grandes durante limpeza e conversão.</string>
    <string name="settings_max_bitmap_size">Resolução Máxima de Processamento</string>
    <string name="settings_max_bitmap_size_subtitle">Maior lado em pixels ao decodificar imagens na memória. Valores menores usam menos RAM.</string>
    <string name="settings_video_fallback">Limpeza de Vídeo Mais Rápida</string>
    <string name="settings_video_fallback_subtitle">Quando seu vídeo já está em um formato compatível, o Redact remove seus metadados com uma passagem rápida em vez de recodificá-lo por completo — mais rápido e mais leve para a bateria, embora uma recodificação completa remova um pouco mais. Desativado automaticamente quando a Limpeza Rigorosa está ativa ou ao limpar arquivos compartilhados de outros apps.</string>

    <string-array name="settings_secure_delete_labels">
        <item>1 Passagem (Rápida)</item>
        <item>3 Passagens (Segura)</item>
        <item>7 Passagens (Ultrasegura)</item>
    </string-array>

    <string-array name="settings_max_bitmap_size_labels">
        <item>2048px (Pouca RAM)</item>
        <item>4096px (Padrão)</item>
        <item>8192px (Alto Desempenho)</item>
    </string-array>

    
    <string name="navigation_settings">Configurações</string>
    <string name="settings_section_notifications">Notificações</string>
    <string name="settings_section_notifications_subtitle">Alertas quando as tarefas terminam e progresso ao vivo opcional ao limpar ou converter.</string>
    <string name="settings_notifications_label">Permitir Notificações</string>
    <string name="settings_notifications_subtitle">Interruptor principal de todos os alertas do Redact. Desligado por padrão; o Android pode pedir permissão ao ativar.</string>
    <string name="settings_notifications_clean_label">Limpeza Concluída</string>
    <string name="settings_notifications_clean_subtitle">Alerta quando a remoção de metadados na aba Limpar termina.</string>
    <string name="settings_notifications_convert_label">Conversão Concluída</string>
    <string name="settings_notifications_convert_subtitle">Alerta quando a conversão de formato na aba Converter termina.</string>
    <string name="settings_section_diagnostics">Diagnóstico e Feedback</string>
    <string name="settings_section_diagnostics_subtitle">Relatórios opcionais para corrigir falhas. Sua mídia nunca sai do dispositivo.</string>
    <string name="settings_crash_reporting_label">Enviar Relatórios de Falha</string>
    <string name="settings_crash_reporting_subtitle">Compartilha apenas detalhes técnicos anonimizados (versão do app, modelo do dispositivo, o que o app estava fazendo quando travou) — nunca suas fotos ou vídeos. Enviados pela internet ao nosso serviço de relatório de falhas, o Sentry, quando ativado.</string>
    <string name="settings_section_conversion">Padrões da Aba Converter</string>
    <string name="settings_conversion_subtitle">Formatos pré-selecionados ao escolher arquivos em Converter. Você ainda pode alterá-los em cada lote.</string>
