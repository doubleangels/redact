    <string name="settings_section_advanced_privacy">Metadaten-Bereinigung</string>
    <string name="settings_advanced_privacy_subtitle">Wie Redact EXIF auf dem Tab Bereinigen entfernt. Beim Teilen aus anderen Apps werden Standort und Kamerainfo immer vor dem Weiterleiten entfernt.</string>
    <string name="settings_secure_delete">Sichere Löschdurchläufe</string>
    <string name="settings_secure_delete_subtitle">Wie oft temporäre Dateien vor dem Löschen überschrieben werden. Mehr Durchläufe sind langsamer; auf Flash-Speicher ist Wiederherstellung ggf. trotzdem möglich.</string>
    <string name="settings_auto_clear_temp">Cache beim Start leeren</string>
    <string name="settings_auto_clear_temp_subtitle">Entfernt Verarbeitungs-Cache-Dateien älter als 24 Stunden beim App-Start.</string>
    <string name="settings_preserve_camera">Kameraeinstellungen behalten</string>
    <string name="settings_preserve_camera_subtitle">Blende, Verschlusszeit, ISO und Kameramarke/-modell auf Bereinigen behalten. Ignoriert bei Strikter Bereinigung oder beim Teilen aus anderen Apps.</string>
    <string name="settings_preserve_location">Standort behalten</string>
    <string name="settings_preserve_location_subtitle">GPS-Koordinaten auf Bereinigen behalten. Ignoriert bei Strikter Bereinigung oder beim Teilen aus anderen Apps.</string>
    <string name="settings_strict_clean">Strikte Bereinigung</string>
    <string name="settings_strict_clean_subtitle">Alle Metadaten entfernen, einschließlich Orientierung. Schaltet Behalten-Optionen aus und kodiert Videos immer vollständig neu.</string>
    
    <string name="settings_section_advanced_processing">Große Dateien &amp; Speicher</string>
    <string name="settings_advanced_processing_subtitle">Grenzen für sehr große Bilder beim Bereinigen und Konvertieren. Ändert nicht die Videobereinigung.</string>
    <string name="settings_max_bitmap_size">Max. Verarbeitungsauflösung</string>
    <string name="settings_max_bitmap_size_subtitle">Längste Kante in Pixeln beim Dekodieren im Speicher. Niedrigere Werte nutzen weniger RAM.</string>
    <string name="settings_max_file_size">Max. Eingabedateigröße</string>
    <string name="settings_max_file_size_subtitle">Bilder über dieser Größe überspringen oder verkleinern, um Speicherfehler zu vermeiden.</string>
    <string name="settings_video_fallback">Schnellere Videobereinigung</string>
    <string name="settings_video_fallback_subtitle">Vollständige Neukodierung nach schnellem Remux überspringen, wenn die Ausgabe bereits MP4-kompatibel ist. Spart Zeit und Akku; vollständige Transkodierung entfernt mehr Metadaten. Aus bei Strikter Bereinigung oder Teilen aus anderen Apps.</string>

