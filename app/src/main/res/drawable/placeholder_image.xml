<?xml version="1.0" encoding="utf-8"?>
<!-- A thumbnail still loading: a faint picture on the surface, in theme colors so it suits light
     and dark. Sized like error_image, so the tile does not change scale when a load fails. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="96dp"
                android:height="96dp" />
            <solid android:color="?attr/colorSurfaceContainerHigh" />
        </shape>
    </item>
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="center">
        <vector
            android:width="32dp"
            android:height="32dp"
            android:alpha="0.5"
            android:tint="?attr/colorOnSurfaceVariant"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="@android:color/white"
                android:pathData="M21,19V5c0,-1.1 -0.9,-2 -2,-2H5c-1.1,0 -2,0.9 -2,2v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2zM8.5,13.5l2.5,3.01L14.5,12l4.5,6H5l3.5,-4.5z" />
        </vector>
    </item>
</layer-list>
