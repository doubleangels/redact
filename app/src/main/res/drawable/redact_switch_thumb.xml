<?xml version="1.0" encoding="utf-8"?>
<!-- Widget.Redact.MaterialSwitch's thumb: Material's sizes per state, as rounded squares. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:drawable="@drawable/redact_switch_thumb_pressed" android:state_pressed="true" />
    <item android:drawable="@drawable/redact_switch_thumb_checked" android:state_checked="true" />
    <item android:drawable="@drawable/redact_switch_thumb_checked" app:state_with_icon="true" />
    <item android:drawable="@drawable/redact_switch_thumb_unchecked" />
</selector>
