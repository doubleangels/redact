<?xml version="1.0" encoding="utf-8"?>
<!-- Material's fade through, incoming tab: hidden while the old tab fades out (90ms), then fades in
     while growing from 92% (210ms). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="sequentially">

    <set android:ordering="together">
        <objectAnimator
            android:duration="90"
            android:propertyName="alpha"
            android:valueFrom="0"
            android:valueTo="0"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="90"
            android:propertyName="scaleX"
            android:valueFrom="0.92"
            android:valueTo="0.92"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="90"
            android:propertyName="scaleY"
            android:valueFrom="0.92"
            android:valueTo="0.92"
            android:valueType="floatType" />
    </set>

    <set android:ordering="together">
        <objectAnimator
            android:duration="210"
            android:interpolator="@interpolator/emphasized_decelerate"
            android:propertyName="alpha"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="210"
            android:interpolator="@interpolator/emphasized_decelerate"
            android:propertyName="scaleX"
            android:valueFrom="0.92"
            android:valueTo="1"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="210"
            android:interpolator="@interpolator/emphasized_decelerate"
            android:propertyName="scaleY"
            android:valueFrom="0.92"
            android:valueTo="1"
            android:valueType="floatType" />
    </set>
</set>
