<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".CensorFragment"
    tools:ignore="Overdraw">

    <include
        layout="@layout/censor_empty_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The open photo: its summary card, the tools card, and the photo filling the space
         left all the way to the bottom. Not scrollable, so drawing on the photo never scrolls
         the screen. -->
    <LinearLayout
        android:id="@+id/censorContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_edge_padding"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/censorSummaryCard"
            layout="@layout/summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include layout="@layout/censor_tools_card" />

        <include
            layout="@layout/censor_canvas_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <include layout="@layout/censor_actions" />

</androidx.constraintlayout.widget.ConstraintLayout>
