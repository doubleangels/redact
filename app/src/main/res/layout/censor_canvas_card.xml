<?xml version="1.0" encoding="utf-8"?>
<!-- The photo being censored; the parent sizes it to take the space that is left. The tools are in
     the toolbar under it (censor_toolbar), so only what has to sit on the photo is over it: undo,
     redo and full screen in a pill at its top end, the brush size while Brush is the tool, the
     actions for the selected rectangle or the crop, and the zoom level. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/censorCanvasCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/component_corner_large"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <com.doubleangels.redact.ui.CensorCanvasView
        android:id="@+id/censorCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/censor_canvas_description" />

    <!-- Status: shown while saving, after a save that came out smaller than the original, and after
         a failed save. A plain success is a short notice instead, so nothing stays over the result.
         Over the photo rather than in its own row, so the photo does not shift when it appears; it
         moves below the brush size bar while that shows. -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/censor_top_pill_clearance"
        android:background="@drawable/bg_rounded_surface"
        android:backgroundTint="?attr/colorSurfaceContainerHighest"
        android:elevation="4dp"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingVertical="@dimen/spacing_small"
        android:textAlignment="viewStart"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone" />

    <!-- Brush size, while Brush is the tool: a bar across the top, clear of the pill at the top end.
         The dot at its end grows and shrinks with the brush, so the size reads without dragging. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/censorBrushSizeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/censor_top_pill_clearance"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_medium">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_brush"
                app:tint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.slider.Slider
                android:id="@+id/censorBrushSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:saveEnabled="false"
                android:contentDescription="@string/censor_brush_size"
                android:stepSize="1"
                android:value="4"
                android:valueFrom="1"
                android:valueTo="10"
                app:labelBehavior="gone"
                app:tickVisibilityMode="hidden" />

            <!-- Holds the dot at its largest, so the slider keeps its width as the dot changes. -->
            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp">

                <View
                    android:id="@+id/censorBrushSizeDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_brush_size_dot"
                    android:backgroundTint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Undo, Redo and Full Screen: one raised pill over the photo's top end. It shows whenever the
         photo does, with Undo and Redo disabled until there is something to undo or redo, so it
         never appears and disappears under the user's finger. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/censorHistoryControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/spacing_medium"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/censorUndoButton"
                style="@style/Widget.Redact.Censor.IconButton"
                android:contentDescription="@string/censor_undo"
                android:enabled="false"
                android:tooltipText="@string/censor_undo"
                app:icon="@drawable/ic_undo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/censorRedoButton"
                style="@style/Widget.Redact.Censor.IconButton"
                android:contentDescription="@string/censor_redo"
                android:enabled="false"
                android:tooltipText="@string/censor_redo"
                app:icon="@drawable/ic_redo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/censorFullScreenButton"
                style="@style/Widget.Redact.Censor.IconButton"
                android:contentDescription="@string/censor_full_screen"
                android:tooltipText="@string/censor_full_screen"
                app:icon="@drawable/ic_fullscreen" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Actions on what is selected: Delete beside the selected rectangle (above it, or below it
         near the top), and Reset Crop at the bottom while the crop tool shows a crop. Placed in
         code by translation from the top left, which is why its gravity is left rather than start;
         it shows only while one of them applies. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/censorContextActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        tools:ignore="RtlHardcoded"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/censorResetCropButton"
                style="@style/Widget.Redact.Censor.IconButton"
                android:contentDescription="@string/censor_reset_crop"
                android:tooltipText="@string/censor_reset_crop"
                android:visibility="gone"
                app:icon="@drawable/ic_crop_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/censorDeleteButton"
                style="@style/Widget.Redact.Censor.IconButton"
                android:contentDescription="@string/censor_delete_rectangle"
                android:tooltipText="@string/censor_delete_rectangle"
                android:visibility="gone"
                app:icon="@drawable/ic_delete"
                app:iconTint="?attr/colorError" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- The zoom level while zoomed in; tapping it shows the whole photo again. Placed at bottom-start
         so it never collides with the primary action button in the bottom right. -->
    <com.google.android.material.chip.Chip
        android:id="@+id/censorZoomChip"
        style="@style/Widget.Material3.Chip.Assist.Elevated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/spacing_medium"
        android:visibility="gone"
        app:chipIcon="@drawable/ic_pan"
        app:chipIconSize="18dp" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/censorLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/censorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="@dimen/spacing_xlarge"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</com.google.android.material.card.MaterialCardView>
