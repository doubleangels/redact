<?xml version="1.0" encoding="utf-8"?>
<!-- Save Copy, then Share and Scan Result beside it once a copy is saved: the same buttons as
     Clean and Convert, in one row so the photo keeps as much height as it can. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/censorSaveButton"
        style="@style/Widget.Material3.ExtendedFloatingActionButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/censor_save"
        android:textColor="?attr/colorOnPrimary"
        android:visibility="gone"
        app:backgroundTint="?attr/colorPrimary"
        app:icon="@drawable/ic_censor"
        app:iconTint="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/shareResultsButton"
        style="@style/Widget.Material3.ExtendedFloatingActionButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="@string/button_share_results"
        android:visibility="gone"
        app:icon="@drawable/ic_share"
        app:layout_constraintBottom_toBottomOf="@id/censorSaveButton"
        app:layout_constraintEnd_toStartOf="@id/censorSaveButton"
        app:layout_goneMarginBottom="16dp"
        app:layout_goneMarginEnd="16dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/scanResultButton"
        style="@style/Widget.Material3.FloatingActionButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/button_scan_result"
        android:tooltipText="@string/button_scan_result"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/shareResultsButton"
        app:layout_constraintEnd_toStartOf="@id/shareResultsButton"
        app:srcCompat="@drawable/ic_scan" />
</merge>
