<?xml version="1.0" encoding="utf-8"?>
<!-- The card at the top of Clean, Convert and Censor once something is selected: the tab's icon,
     what is selected, and Select and Clear as a connected button group on the same row, with a
     how-to line under it until the tab has been used once. Everything sits 16dp from the card's
     edges: the 12dp padding plus the buttons' 4dp touch-target inset, or the hint's 4dp margin.
     SummaryCard.bind() sets the icon, hint and select label for each tab. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/component_corner_large"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/summaryIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@null"
                app:tint="?attr/colorPrimary"
                tools:src="@drawable/ic_clean" />

            <TextView
                android:id="@+id/summaryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingVertical="4dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="4 files selected" />

            <!-- Material's connected button group: 40dp tall buttons in 48dp touch targets. -->
            <com.google.android.material.button.MaterialButtonGroup
                style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectButton"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/button_select_media"
                    android:insetLeft="0dp"
                    android:insetTop="4dp"
                    android:insetRight="0dp"
                    android:insetBottom="4dp"
                    android:padding="0dp"
                    android:tooltipText="@string/button_select_media"
                    app:icon="@drawable/ic_add_photo"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/summaryClearButton"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/clean_clear_selection"
                    android:insetLeft="0dp"
                    android:insetTop="4dp"
                    android:insetRight="0dp"
                    android:insetBottom="4dp"
                    android:padding="0dp"
                    android:tooltipText="@string/clean_clear_selection"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp" />
            </com.google.android.material.button.MaterialButtonGroup>
        </LinearLayout>

        <!-- Under the row rather than beside the title, so it keeps the width it had before the
             buttons moved up and stays as short as it can. Lined up with the title. -->
        <TextView
            android:id="@+id/summaryHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="38dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="@string/clean_selected_hint" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
