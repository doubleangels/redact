    <string name="settings_section_advanced_privacy">中繼資料清理</string>
    <string name="settings_advanced_privacy_subtitle">Redact 如何在清理分頁移除隱藏資訊，例如位置與相機詳情（EXIF）。從其他 App 分享的檔案在轉寄前一律會移除這些資訊。</string>
    <string name="settings_secure_delete">安全刪除次數</string>
    <string name="settings_secure_delete_subtitle">刪除前覆寫暫存檔（包含清理前的原始相片和影片副本）的次數，使其資料無法從磁碟復原。次數越多越慢；在快閃記憶體上仍可能復原資料。</string>
    <string name="settings_auto_clear_temp">啟動時清除快取</string>
    <string name="settings_auto_clear_temp_subtitle">開啟應用程式時刪除超過 24 小時的處理快取檔案。</string>
    <string name="settings_preserve_camera">保留相機設定</string>
    <string name="settings_preserve_camera_subtitle">在清理分頁保留光圈、快門速度、ISO 與相機品牌/型號。嚴格清理開啟或從其他 App 分享時忽略。</string>
    <string name="settings_preserve_location">保留位置</string>
    <string name="settings_preserve_location_subtitle">在清理分頁保留 GPS 座標。嚴格清理開啟或從其他 App 分享時忽略。</string>
        <string name="settings_sentry_consent_allow">啟用</string>
    <string name="settings_sentry_consent_cancel">暫不</string>
    <string name="settings_sentry_consent_title">啟用當機報告</string>
    <string name="settings_sentry_consent_message">傳送當機報告會透過網際網路向 Sentry 上傳匿名診斷資訊。\n\n不會上傳照片、影片、檔名或 GPS 座標。</string>
    <string name="settings_strict_clean">嚴格清理</string>
    <string name="settings_strict_clean_subtitle">移除所有中繼資料痕跡，甚至包括方向標籤，因此旋轉過的相片之後可能會顯示為歪斜。關閉下方的保留選項，並一律完整重新編碼影片，以達到最徹底的清理。</string>
    
    <string name="settings_section_advanced_processing">大型檔案與記憶體</string>
    <string name="settings_advanced_processing_subtitle">控制清理和轉換時解碼大型影像的記憶體使用。</string>
    <string name="settings_max_bitmap_size">最大處理解析度</string>
    <string name="settings_max_bitmap_size_subtitle">在記憶體中解碼影像時的最長邊像素數。較低值使用較少 RAM。</string>
    <string name="settings_video_fallback">更快的影片清理</string>
    <string name="settings_video_fallback_subtitle">當影片已是相容格式時，Redact 會以快速處理移除其中繼資料，而非完整重新編碼，速度更快、更省電，不過完整重新編碼能多移除一些。在開啟嚴格清理或清理從其他 App 分享的檔案時，會自動關閉此功能。</string>

    <string-array name="settings_secure_delete_labels">
        <item>1 次（快速）</item>
        <item>3 次（安全）</item>
        <item>7 次（超安全）</item>
    </string-array>

