    <string name="settings_section_advanced_privacy">Limpieza de metadatos</string>
    <string name="settings_advanced_privacy_subtitle">Cómo Redact elimina EXIF en la pestaña Limpiar. Al compartir desde otras apps siempre se eliminan ubicación e info de cámara antes de reenviar.</string>
    <string name="settings_secure_delete">Pasadas De Borrado Seguro</string>
    <string name="settings_secure_delete_subtitle">Cuántas veces se sobrescriben los archivos temporales antes de borrarlos. Más pasadas son más lentas; en almacenamiento flash la recuperación puede seguir siendo posible.</string>
    <string name="settings_auto_clear_temp">Vaciar caché al iniciar</string>
    <string name="settings_auto_clear_temp_subtitle">Elimina archivos de caché de procesamiento de más de 24 horas al abrir la app.</string>
    <string name="settings_preserve_camera">Conservar ajustes de cámara</string>
    <string name="settings_preserve_camera_subtitle">Conservar apertura, velocidad de obturación, ISO y marca/modelo de cámara en Limpiar. Ignorado con Limpieza Estricta o al compartir desde otras apps.</string>
    <string name="settings_preserve_location">Conservar ubicación</string>
    <string name="settings_preserve_location_subtitle">Conservar coordenadas GPS en Limpiar. Ignorado con Limpieza Estricta o al compartir desde otras apps.</string>
    <string name="settings_strict_clean">Limpieza Estricta</string>
    <string name="settings_strict_clean_subtitle">Eliminar todos los metadatos, incluida la orientación. Desactiva las opciones de conservar y siempre recodifica video por completo.</string>
    
    <string name="settings_section_advanced_processing">Archivos grandes y memoria</string>
    <string name="settings_advanced_processing_subtitle">Límites para imágenes muy grandes al limpiar y convertir. No cambia la limpieza de video.</string>
    <string name="settings_max_bitmap_size">Resolución máxima de procesamiento</string>
    <string name="settings_max_bitmap_size_subtitle">Lado más largo en píxeles al decodificar en memoria. Valores más bajos usan menos RAM.</string>
    <string name="settings_max_file_size">Tamaño máximo de archivo de entrada</string>
    <string name="settings_max_file_size_subtitle">Omitir o reducir imágenes por encima de este tamaño para evitar errores de memoria.</string>
    <string name="settings_video_fallback">Limpieza De Video Más Rápida</string>
    <string name="settings_video_fallback_subtitle">Omitir la recodificación completa tras un remux rápido cuando la salida ya es compatible con MP4. Ahorra tiempo y batería; la transcodificación completa elimina más metadatos. Desactivado con Limpieza Estricta o al compartir desde otras apps.</string>

