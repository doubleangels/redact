    <string name="settings_section_advanced_privacy">元数据清理</string>
    <string name="settings_advanced_privacy_subtitle">Redact 如何在清理标签页移除隐藏信息，例如位置和相机详情（EXIF）。从其他应用分享的文件在转发前始终会移除这些信息。</string>
    <string name="settings_secure_delete">安全删除遍数</string>
    <string name="settings_secure_delete_subtitle">删除前覆写临时文件（包括清理前的原始照片和视频副本）的次数，使其数据无法从磁盘恢复。次数越多越慢；在闪存上仍可能恢复数据。</string>
    <string name="settings_auto_clear_temp">启动时清除缓存</string>
    <string name="settings_auto_clear_temp_subtitle">打开应用时删除超过 24 小时的处理缓存文件。</string>
    <string name="settings_preserve_camera">保留相机设置</string>
    <string name="settings_preserve_camera_subtitle">在清理标签页保留光圈、快门速度、ISO 和相机品牌/型号。严格清理开启或从其他应用分享时忽略。</string>
    <string name="settings_preserve_location">保留位置</string>
    <string name="settings_preserve_location_subtitle">在清理标签页保留 GPS 坐标。严格清理开启或从其他应用分享时忽略。</string>
        <string name="settings_sentry_consent_allow">启用</string>
    <string name="settings_sentry_consent_cancel">暂不</string>
    <string name="settings_sentry_consent_title">启用崩溃报告</string>
    <string name="settings_sentry_consent_message">发送崩溃报告会通过互联网向 Sentry 上传匿名诊断信息。\n\n不会上传照片、视频、文件名或 GPS 坐标。</string>
    <string name="settings_strict_clean">严格清理</string>
    <string name="settings_strict_clean_subtitle">移除所有元数据痕迹，甚至包括方向标签，因此旋转过的照片之后可能会显示为歪斜。关闭下方的保留选项，并始终完全重新编码视频以实现最彻底的清理。</string>
    
    <string name="settings_section_advanced_processing">大文件与内存</string>
    <string name="settings_advanced_processing_subtitle">控制清理和转换时解码大图像的内存使用。</string>
    <string name="settings_max_bitmap_size">最大处理分辨率</string>
    <string name="settings_max_bitmap_size_subtitle">在内存中解码图像时的最长边像素数。较低值使用更少 RAM。</string>
    <string name="settings_video_fallback">更快的视频清理</string>
    <string name="settings_video_fallback_subtitle">当视频已经是兼容格式时，Redact 会用快速处理来移除其元数据，而不是完全重新编码，速度更快、更省电，不过完全重新编码能多移除一点。在开启严格清理或清理从其他应用分享的文件时会自动关闭此功能。</string>

    <string-array name="settings_secure_delete_labels">
        <item>1 遍（快速）</item>
        <item>3 遍（安全）</item>
        <item>7 遍（超安全）</item>
    </string-array>

    <string-array name="settings_max_bitmap_size_labels">
        <item>原始分辨率</item>
        <item>2048px（低内存）</item>
        <item>4096px（标准）</item>
        <item>8192px（高性能）</item>
    </string-array>

    
