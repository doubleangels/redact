    <string name="settings_crash_reporting_label">Invia Report di Crash</string>
    <string name="settings_crash_reporting_subtitle">Solo diagnostica anonima (versione app, modello dispositivo, stack trace). Se attivato, i dati vengono inviati a Sentry via internet. Foto e video non vengono mai caricati.</string>
