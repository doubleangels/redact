    <string name="settings_notifications_label">Consenti Notifiche</string>
    <string name="settings_notifications_subtitle">Interruttore principale per tutti gli avvisi Redact. Disattivato di default; Android può chiedere il permesso all\'attivazione.</string>
    <string name="settings_notifications_clean_label">Pulizia Completata</string>
