<resources>
    <!-- Base colors (used for preview and as fallback) -->
    <color name="splash_background">@android:color/system_neutral1_100</color>
    <color name="icon_background">@android:color/system_accent1_100</color>
    <color name="icon_body">@android:color/system_accent1_800</color>
    <color name="icon_detail">@android:color/system_accent1_50</color>
    <!-- The app's own Material 3 scheme, for where Android offers no wallpaper colors (Android 12
         phones from makers without dynamic color): Material's monochrome scheme from #333333 (2021
         spec, as Material Components uses), the black and white system theme the store
         screenshots are taken with (scripts/screenshots.sh). The dark values are in
         values-night. -->
    <color name="md_theme_primary">#000000</color>
    <color name="md_theme_on_primary">#E2E2E2</color>
    <color name="md_theme_primary_container">#3B3B3B</color>
    <color name="md_theme_on_primary_container">#FFFFFF</color>
    <color name="md_theme_inverse_primary">#C6C6C6</color>
    <color name="md_theme_secondary">#5E5E5E</color>
    <color name="md_theme_on_secondary">#FFFFFF</color>
    <color name="md_theme_secondary_container">#D4D4D4</color>
    <color name="md_theme_on_secondary_container">#1B1B1B</color>
    <color name="md_theme_tertiary">#3B3B3B</color>
    <color name="md_theme_on_tertiary">#E2E2E2</color>
    <color name="md_theme_tertiary_container">#747474</color>
    <color name="md_theme_on_tertiary_container">#FFFFFF</color>
    <color name="md_theme_error">#BA1A1A</color>
    <color name="md_theme_on_error">#FFFFFF</color>
    <color name="md_theme_error_container">#FFDAD6</color>
    <color name="md_theme_on_error_container">#410002</color>
    <color name="md_theme_background">#F9F9F9</color>
    <color name="md_theme_on_background">#1B1B1B</color>
    <color name="md_theme_surface">#F9F9F9</color>
    <color name="md_theme_on_surface">#1B1B1B</color>
    <color name="md_theme_surface_variant">#E2E2E2</color>
    <color name="md_theme_on_surface_variant">#474747</color>
    <color name="md_theme_surface_dim">#DADADA</color>
    <color name="md_theme_surface_bright">#F9F9F9</color>
    <color name="md_theme_surface_container_lowest">#FFFFFF</color>
    <color name="md_theme_surface_container_low">#F3F3F3</color>
    <color name="md_theme_surface_container">#EEEEEE</color>
    <color name="md_theme_surface_container_high">#E8E8E8</color>
    <color name="md_theme_surface_container_highest">#E2E2E2</color>
    <color name="md_theme_inverse_surface">#303030</color>
    <color name="md_theme_inverse_on_surface">#F1F1F1</color>
    <color name="md_theme_outline">#777777</color>
    <color name="md_theme_outline_variant">#C6C6C6</color>

    <!-- "Granted" in Settings: green at Material's text tones (40 on light surfaces), harmonized at
         runtime with the wallpaper's primary where there is one. -->
    <color name="permission_status_granted">#006E2A</color>

    <!-- Launcher shortcut icons; the launcher cannot resolve theme attributes, and draws them
         on a white circle in both light and dark mode, so one darker tone serves both. -->
    <color name="shortcut_icon">@android:color/system_accent1_600</color>

    <!-- Utility colors -->
    <color name="black">#FF000000</color>
</resources>