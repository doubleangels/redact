<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rounded squares throughout: Material 3 draws buttons, icon buttons, button groups,
         and navigation indicators as pills or circles, so each style the app uses is
         redone here with the app's corner sizes. Cards, chips, dialogs, sheets and FABs take their
         corners from the shapeCornerSize* values in Theme.Redact instead. -->

    <style name="Widget.Redact.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.Redact.BottomNavigationView.ActiveIndicator</item>
    </style>

    <style name="Widget.Redact.NavigationRailView.ActiveIndicator" parent="Widget.Material3.NavigationRailView.ActiveIndicator">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.NavigationRailView" parent="Widget.Material3.NavigationRailView">
        <item name="itemActiveIndicatorStyle">@style/Widget.Redact.NavigationRailView.ActiveIndicator</item>
    </style>

    <style name="TextAppearance.Redact.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Redact.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.Button.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.Button.TextButton.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.Button.TextButton.Dialog.Flush" parent="Widget.Material3.Button.TextButton.Dialog.Flush">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.Button.TextButton.Snackbar" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.Button.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.Button.IconButton.Filled.Tonal" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
    </style>

    <style name="Widget.Redact.MaterialButtonGroup.Connected" parent="Widget.Material3.MaterialButtonGroup.Connected">
        <item name="shapeAppearance">@style/ShapeAppearance.Redact.Control</item>
        <item name="innerCornerSize">4dp</item>
    </style>

    <!-- The Censor editor's icon buttons: a 48dp touch target around a 24dp icon. -->
    <style name="Widget.Redact.Censor.IconButton" parent="Widget.Redact.Button.IconButton">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:insetLeft">@dimen/button_inset</item>
        <item name="android:insetTop">@dimen/button_inset</item>
        <item name="android:insetRight">@dimen/button_inset</item>
        <item name="android:insetBottom">@dimen/button_inset</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">@dimen/icon_size</item>
    </style>


    <!-- Dialog buttons and Snackbar actions with the app's button corners. -->
    <style name="ThemeOverlay.Redact.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarButtonStyle">@style/Widget.Redact.Button.TextButton.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Redact.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Redact.Button.TextButton.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Redact.Button.TextButton.Dialog.Flush</item>
    </style>
</resources>
