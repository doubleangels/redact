    <string name="settings_section_advanced_privacy">Metadata Cleaning</string>
    <string name="settings_advanced_privacy_subtitle">How Redact removes EXIF on the Clean tab. Share-in always strips location and camera info before forwarding.</string>
    <string name="settings_secure_delete">Secure Deletion Passes</string>
    <string name="settings_secure_delete_subtitle">How many times temporary files are overwritten before deletion. More passes are slower; on flash storage, recovery may still be possible.</string>
    <string name="settings_auto_clear_temp">Clear Cache on Startup</string>
    <string name="settings_auto_clear_temp_subtitle">Remove processing cache files older than 24 hours when you open the app.</string>
    <string name="settings_preserve_camera">Keep Camera Settings</string>
    <string name="settings_preserve_camera_subtitle">Retain aperture, shutter speed, ISO, and camera make/model on the Clean tab. Ignored when Strict Clean is on or when sharing from other apps.</string>
    <string name="settings_preserve_location">Keep Location</string>
    <string name="settings_preserve_location_subtitle">Retain GPS coordinates on the Clean tab. Ignored when Strict Clean is on or when sharing from other apps.</string>
    <string name="settings_preserve_location_confirm_title">Keep GPS on cleaned photos?</string>
    <string name="settings_preserve_location_confirm_message">Cleaned files on the Clean tab may still contain GPS coordinates. Sharing from other apps always strips location.\n\nTurn this on only if you intentionally want location kept.</string>
    <string name="settings_location_permission_granted">Photo location permission granted.</string>
    <string name="settings_location_permission_denied">Photo location permission denied.</string>
    <string name="settings_crash_reporting_unconfigured">Crash reporting is enabled but not configured on this build.</string>
    <string name="settings_crash_reporting_init_failed">Crash reporting could not start. Try again later.</string>
    <string name="settings_network_consent_allow">Allow Network Access</string>
    <string name="settings_network_consent_cancel">Not Now</string>
    <string name="settings_network_consent_crash_title">Allow crash reporting over the network?</string>
    <string name="settings_network_consent_crash_message">Send Crash Reports uploads anonymized diagnostics to Sentry over the internet. Redact does not use the network until you allow this.\n\nNo photos, videos, filenames, or GPS coordinates are uploaded.</string>
    <string name="settings_strict_clean">Strict Clean</string>
    <string name="settings_strict_clean_subtitle">Remove all metadata, including orientation. Turns off keep options above and always fully re-encodes video.</string>
    <string name="settings_video_fallback">Faster Video Cleaning</string>
    <string name="settings_video_fallback_subtitle">Skip full re-encoding after a quick remux when output is already MP4-compatible. Saves time and battery; full transcode removes more metadata. Off when Strict Clean is on or when sharing from other apps.</string>
    
    <string name="settings_section_advanced_processing">Large Files &amp; Memory</string>
    <string name="settings_advanced_processing_subtitle">Limits for very large images during clean and convert. Does not change video cleaning behavior.</string>
    <string name="settings_max_bitmap_size">Max Processing Resolution</string>
    <string name="settings_max_bitmap_size_subtitle">Largest edge in pixels when decoding images in memory. Lower values use less RAM.</string>
    <string name="settings_max_file_size">Max Input File Size</string>
    <string name="settings_max_file_size_subtitle">Skip or downscale images above this size to avoid out-of-memory errors.</string>

