    <string name="settings_section_advanced_privacy">Nettoyage des métadonnées</string>
    <string name="settings_advanced_privacy_subtitle">Comment Redact supprime l\'EXIF dans l\'onglet Nettoyer. Le partage depuis d\'autres apps supprime toujours la localisation et les infos appareil photo avant le transfert.</string>
    <string name="settings_secure_delete">Passes De Suppression Sécurisée</string>
    <string name="settings_secure_delete_subtitle">Nombre de réécritures des fichiers temporaires avant suppression. Plus de passes = plus lent mais plus difficile à récupérer.</string>
    <string name="settings_auto_clear_temp">Vider le cache au démarrage</string>
    <string name="settings_auto_clear_temp_subtitle">Supprimer les fichiers de traitement restants à chaque ouverture de l\'app.</string>
    <string name="settings_preserve_camera">Conserver les réglages photo</string>
    <string name="settings_preserve_camera_subtitle">Conserver ouverture, vitesse d\'obturation, ISO et marque/modèle appareil photo dans Nettoyer. Ignoré avec Nettoyage Strict ou lors d\'un partage depuis d\'autres apps.</string>
    <string name="settings_preserve_location">Conserver la position</string>
    <string name="settings_preserve_location_subtitle">Conserver les coordonnées GPS dans Nettoyer. Ignoré avec Nettoyage Strict ou lors d\'un partage depuis d\'autres apps.</string>
    <string name="settings_strict_clean">Nettoyage Strict</string>
    <string name="settings_strict_clean_subtitle">Supprimer toutes les métadonnées, y compris l\'orientation. Désactive les options de conservation et réencode toujours entièrement la vidéo.</string>
    
    <string name="settings_section_advanced_processing">Fichiers volumineux et mémoire</string>
    <string name="settings_advanced_processing_subtitle">Limites pour les très grandes images lors du nettoyage et de la conversion. N\'affecte pas le nettoyage vidéo.</string>
    <string name="settings_max_bitmap_size">Résolution max. de traitement</string>
    <string name="settings_max_bitmap_size_subtitle">Côté le plus long en pixels lors du décodage en mémoire. Des valeurs plus basses utilisent moins de RAM.</string>
    <string name="settings_max_file_size">Taille max. du fichier d\'entrée</string>
    <string name="settings_max_file_size_subtitle">Ignorer ou réduire les images au-dessus de cette taille pour éviter les erreurs mémoire.</string>
    <string name="settings_video_fallback">Nettoyage Vidéo Plus Rapide</string>
    <string name="settings_video_fallback_subtitle">Ignorer le réencodage complet après un remux rapide lorsque la sortie est déjà compatible MP4. Économise temps et batterie ; la transcodification complète supprime plus de métadonnées. Désactivé avec Nettoyage Strict ou partage depuis d\'autres apps.</string>

