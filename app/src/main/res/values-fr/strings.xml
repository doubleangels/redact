    <string name="settings_section_notifications">Notifications</string>
    <string name="settings_section_notifications_subtitle">Alertes à la fin des tâches et progression en direct optionnelle lors du nettoyage ou de la conversion.</string>
    <string name="settings_notifications_label">Autoriser les Notifications</string>
    <string name="settings_notifications_subtitle">Interrupteur principal des alertes Redact. Désactivé par défaut ; Android peut demander l\'autorisation à l\'activation.</string>
    <string name="settings_notifications_clean_label">Nettoyage Terminé</string>
    <string name="settings_notifications_clean_subtitle">Alerte lorsque la suppression des métadonnées dans l\'onglet Nettoyer est terminée.</string>
    <string name="settings_notifications_convert_label">Conversion Terminée</string>
    <string name="settings_notifications_convert_subtitle">Alerte lorsque la conversion de format dans l\'onglet Convertir est terminée.</string>
    <string name="settings_section_diagnostics">Diagnostic et Commentaires</string>
    <string name="settings_section_diagnostics_subtitle">Rapports optionnels pour corriger les plantages. Vos médias ne quittent jamais l\'appareil.</string>
    <string name="settings_crash_reporting_label">Envoyer les Rapports de Plantage</string>
    <string name="settings_crash_reporting_subtitle">Diagnostics anonymisés uniquement (version de l\'app, modèle d\'appareil, traces de pile). Si activé, les données sont envoyées à Sentry via Internet. Les photos et vidéos ne sont jamais téléversées.</string>
    <string name="settings_section_conversion">Valeurs par Défaut de Convertir</string>
    <string name="settings_conversion_subtitle">Formats présélectionnés lors du choix des fichiers dans Convertir. Modifiables pour chaque lot.</string>
